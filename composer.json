{
    "name": "darksynx/sublime",
    "description": "A concise immutable HTML builder for PHP 8.3+",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "files": [
            "src/Sublime.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sublime\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "DarkSynx",
            "homepage": "https://github.com/D-Synx"
        }
    ],
    "homepage": "https://github.com/D-Synx/Sublime",
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --using-cache=no --diff",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.59"
    },
    "config": {
        "sort-packages": true
    }
}
